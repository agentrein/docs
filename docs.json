{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "AgentRein",
  "colors": {
    "primary": "#ffffff",
    "light": "#ffffff",
    "dark": "#0e0e10"
  },
  "modeToggle": {
    "default": "dark",
    "isHidden": true
  },
  "contextual": {
    "options": [
      "copy",
      "chatgpt",
      "claude",
      "add-mcp",
      "cursor",
      "vscode"
    ]
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "icon": "rocket",
        "pages": [
          "index",
          "quickstart",
          "core-concepts"
        ]
      },
      {
        "group": "SDK Reference",
        "icon": "code",
        "pages": [
          "sdk/installation",
          "sdk/new-session",
          "sdk/call",
          "api-reference",
          "sdk/undo-config",
          "sdk/connectors",
          "sdk/supported-integrations",
          "sdk/policies",
          "sdk/hitl",
          "sdk/errors"
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/agentrein"
    }
  },
  "appearance": {
    "strict": false,
    "default": "system"
  },
  "description": "AI Agent Reliability Platform",
  "navbar": {
    "links": [
      {
        "href": "https://github.com/agentrein",
        "label": "GitHub"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/AgentReinAi"
    }
  },
  "fonts": {
    "family": "Inter"
  },
  "logo": {
    "light": "/images/logo.svg",
    "dark": "/images/logo.svg"
  },
  "favicon": {
    "light": "/images/light.svg",
    "dark": "/images/dark.svg"
  },
  "background": {
    "color": {
      "dark": "#09090b",
      "light": "#0e0e10"
    }
  },
  "icons": {
    "library": "fontawesome"
  }
}
