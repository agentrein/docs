{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "AgentRein",
  "colors": {
    "primary": "#09090B",
    "light": "#FAFAFA",
    "dark": "#09090B"
  },
  "modeToggle": {
    "default": "dark",
    "isHidden": true
  },
  "contextual": {
    "options": [
      "copy",
      "chatgpt",
      "claude",
      "add-mcp",
      "cursor",
      "vscode"
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart",
              "core-concepts",
              "faq"
            ]
          },
          {
            "group": "SDK Reference",
            "pages": [
              "sdk/installation",
              "sdk/new-session",
              "sdk/call",
              "sdk/undo-config",
              "sdk/connectors",
              "sdk/supported-integrations",
              "sdk/policies",
              "sdk/hitl",
              "sdk/errors"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "pages": [
          "api-reference"
        ]
      },
      {
        "tab": "Changelog",
        "pages": [
          "changelog"
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/agentrein"
    }
  },
  "appearance": {
    "strict": false,
    "default": "system"
  },
  "description": "AI Agent Reliability Platform",
  "navbar": {
    "links": [
      {
        "href": "https://github.com/agentrein",
        "label": "GitHub"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/AgentReinAi"
    }
  },
  "fonts": {
    "family": "Inter"
  },
  "favicon": {
    "light": "/images/light.svg",
    "dark": "/images/dark.svg"
  },
  "icons": {
    "library": "fontawesome"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0E0E10"
    }
  }
}
